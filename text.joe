public class Main {
    static u8 instances;

    fn function(u32 x, i8 y) u32 {
        return x + y;
    }

    fn main() void {
        i32 j = 1 + 1 + 2 + 3 + 5;
        i32 i = 6;

        if (i <= 8 + 2 * 3){
            i = j = 0;
        }
        // hello comment
        /*
         * This
         * is
         * a
         * comment
         */
        if (i != /*comment*/ 0) {
            System.out.println("/* not a comment */abc:?()");
        }
    }
}

public class ExtMain extends Main {}

private enum MyEnum {
    THIS,
    IS(),
    AN(u32),
