public class Main {
    static u8 instances;

    fn function(u32 x, i8 y) u32 {
        return x + y;
    }

    fn main() void {
        i32 j = 1 + 1 + 2 + 3 + 5;
        i32 i = 6;

        if (i <= 8 + 2 * 3){
            i = j = 0;
        }
        // hello comment
        /*
         * This
         * is
         * a
         * comment
         */
        if (i != /*comment*/ 0) {
            System.out.println("/* not a comment */abc:?()");
        }
    }
}

public class ExtMain extends Main {}

private enum MyEnum {
    THIS,
    IS(),
    AN(u32),
    ENUM(u32, InnerClass)
}

private interface MyInterface {
    fn myFunction(MyType myParam) myReturnType;
}

impl MyInterface for MyClass {
    fn myFunction(MyType myParam) myReturnType {
        return null;
    }
}

extern fn getchar() u8;

extern fn printf(u8[] str, ...) i32;

fn main(u32 argc) i32 {
    u8[] arr = new u8[6];
    arr[0] = 'H';
    arr[1] = 'e';
    arr[2] = 'l';
    arr[3] = 'l';
    arr[4] = 'o';
    arr[5] = 0;
    printf("%s\n", arr);
    printf("%d arguments were passed\n", argc);
    return 0;
}
